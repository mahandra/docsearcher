# Copy to .env and fill in. Never commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Used when running Django on the host; docker-compose overrides it for the web container.
DATABASE_URL=postgres://docqa:docqa@localhost:5434/docqa
REDIS_URL=redis://localhost:6380/0

ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=low
LLM_MAX_TOKENS=16000
LLM_MAX_HISTORY_MESSAGES=20
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=120
LLM_PROMPT_CACHING=true
LLM_FALLBACK_MODEL=claude-sonnet-5-5

# Langfuse tracing: leave the keys empty to disable it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com, US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
# false = send only timings, token counts and costs (no questions, passages or answers)
LANGFUSE_CAPTURE_CONTENT=true

VOYAGE_API_KEY=pa-...
EMBEDDING_MODEL=voyage-4
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=20
RETRIEVAL_RRF_K=5
DOCUMENT_MAX_UPLOAD_MB=20
